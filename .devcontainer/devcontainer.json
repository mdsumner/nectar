{
  // Codespaces (and VS Code's Dev Containers): the recipe's image, built by .github/workflows/image.yml.
  // On start, JupyterLab runs on port 8888 and opens in a browser tab, at the same notebook Binder opens; RStudio is
  // in its launcher. No Jupyter token: Codespaces' forwarded ports are private to you unless you change that.
  "name": "Nectar recipe: GDAL + R",
  "image": "ghcr.io/mdsumner/nectar:latest",
  "remoteUser": "rstudio",
  "hostRequirements": { "cpus": 4 },
  "postStartCommand": "setsid nohup jupyter lab --ip=0.0.0.0 --port=8888 --no-browser --IdentityProvider.token= --LabApp.default_url=/lab/tree/binder/try-it.ipynb > /tmp/jupyter.log 2>&1 &",
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": { "label": "JupyterLab (RStudio inside)", "onAutoForward": "openBrowserOnce" }
  },
  "customizations": {
    "codespaces": { "openFiles": [".devcontainer/WELCOME.md"] },
    "vscode": {
      "settings": {
        "r.bracketedPaste": true,
        "r.plot.useHttpgd": false,
        "python.defaultInterpreterPath": "/opt/gdal-py/bin/python",
        "workbench.startupEditor": "none"
      },
      "extensions": ["REditorSupport.r", "ms-python.python"]
    }
  }
}
